# TWRP flags for Motorola Edge 70 Fusion (marvel / SM7635)
# Dynamic Partitions
/system_image          emmc    /dev/block/mapper/system          flags=display="System Image";backup=1;flashimg=1;slotselect;logical
/vendor_image          emmc    /dev/block/mapper/vendor          flags=display="Vendor Image";backup=1;flashimg=1;slotselect;logical
/product_image         emmc    /dev/block/mapper/product         flags=display="Product Image";backup=1;flashimg=1;slotselect;logical
/system_ext_image      emmc    /dev/block/mapper/system_ext      flags=display="System_EXT Image";backup=1;flashimg=1;slotselect;logical
/vendor_dlkm_image     emmc    /dev/block/mapper/vendor_dlkm     flags=display="Vendor_DLKM Image";backup=1;flashimg=1;slotselect;logical
/system_dlkm_image     emmc    /dev/block/mapper/system_dlkm     flags=display="System_DLKM Image";backup=1;flashimg=1;slotselect;logical

# Physical Partitions
/boot                  emmc    /dev/block/bootdevice/by-name/boot          flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot             emmc    /dev/block/bootdevice/by-name/init_boot     flags=display="Init Boot";backup=1;flashimg=1;slotselect
/vendor_boot           emmc    /dev/block/bootdevice/by-name/vendor_boot   flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/dtbo                  emmc    /dev/block/bootdevice/by-name/dtbo          flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta                emmc    /dev/block/bootdevice/by-name/vbmeta        flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system         emmc    /dev/block/bootdevice/by-name/vbmeta_system flags=display="VBMeta System";backup=1;flashimg=1;slotselect

# Userdata & Metadata
/metadata              ext4    /dev/block/bootdevice/by-name/metadata      flags=display="Metadata";backup=1
/data                  f2fs    /dev/block/bootdevice/by-name/userdata      flags=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# Critical Protected Firmware Partitions (Do NOT allow accidental wiping or flashing)
/modem                 vfat    /dev/block/bootdevice/by-name/modem         flags=display="Modem/Radio Firmware";backup=1
/dsp                   ext4    /dev/block/bootdevice/by-name/dsp           flags=display="DSP Firmware";backup=1
/persist               ext4    /dev/block/bootdevice/by-name/persist       flags=display="Persist";backup=1
/misc                  emmc    /dev/block/bootdevice/by-name/misc          flags=display="Misc"

# External Storage
/usb_otg               auto    /devices/platform/soc/a600000.ssusb*        flags=display="USB-OTG";storage;wipeingui=0;removable
