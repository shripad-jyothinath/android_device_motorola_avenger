# Motorola touch init domain
type vendor_touch_init, domain;
type vendor_touch_init_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_touch_init)

allow vendor_touch_init vendor_shell_exec:file rx_file_perms;
allow vendor_touch_init vendor_toolbox_exec:file rx_file_perms;
allow vendor_touch_init sysfs_touchpanel:dir r_dir_perms;
allow vendor_touch_init sysfs_touchpanel:file rw_file_perms;
